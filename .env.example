# Configuración de Firebase (cliente).
# 1. Crea un proyecto en https://console.firebase.google.com
# 2. Añade una app "Web" (</>) y copia los valores de firebaseConfig aquí.
# 3. En Authentication → Sign-in method, habilita "Correo electrónico/contraseña".
# 4. En Firestore Database → Crear base de datos (modo producción).
# 5. Publica las reglas de `firestore.rules` (consola → Firestore → Reglas).
# 6. Copia este archivo a `.env` y reemplaza los valores.
# 7. (Opcional) Siembra el catálogo en Firestore: `npm run seed:catalog`
#    (requiere una clave de cuenta de servicio, ver scripts/seed-catalog.mjs).
#
# Estas claves EXPO_PUBLIC_* NO son secretas: van incluidas en el bundle de la app.
# El control de acceso real se define en las reglas de seguridad de Firebase.

EXPO_PUBLIC_FIREBASE_API_KEY=TU_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# URL pública del backend del chatbot (ver server/README.md para desplegarlo).
# Déjala vacía y la app funciona igual; la pantalla del Asistente mostrará un
# aviso y ofrecerá WhatsApp. Ejemplo: https://megauniformes-api.onrender.com
EXPO_PUBLIC_CHATBOT_API_URL=
