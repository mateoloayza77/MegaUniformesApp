# Backend del chatbot MEGA UNIFORMES.
# Copia este archivo a .env (NO lo subas a git) o define estas variables en el
# panel del hosting (Render / Railway).

# Clave de OpenRouter. Genera una NUEVA en https://openrouter.ai/keys
# (la clave anterior del proyecto web quedó expuesta y debe revocarse).
OPENROUTER_API_KEY=

# Modelo a usar (por defecto openai/gpt-4o-mini).
OPENROUTER_MODEL=openai/gpt-4o-mini
